niw results/

# openpyxl for automation/fetch_eb_inventory.py. Homebrew's Python is PEP 668
# externally-managed, so the dependency lives in a venv rather than site-packages.
# Recreate with: python3 -m venv automation/.venv && automation/.venv/bin/pip install openpyxl
automation/.venv/

# AAO decision indexer: the SCRIPTS are versioned, the data is not.
#   cache/  ~2.6GB of public AAO decision PDFs, re-downloadable from USCIS
#   out/    derived artifacts, regenerated from cache/ in minutes
# out/decisions.json is deliberately NOT committed: it carries per-case identifiers
# lifted from the published PDFs, and this repo is public. It is cheap to rebuild
# (aao_index.py parse) so nothing is lost by leaving it out.
aao-indexer/cache/
aao-indexer/out/
aao-indexer/*.log

# Test-only downloads (axe-core for the a11y audit). Never served to the site.
.cache/
